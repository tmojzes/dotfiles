{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode-go/glm-5.3",

  "default_agent": "build",

  // Explicit allow-all (same behavior as the old V1
  // `"permission": { "*": "allow" }`): nothing prompts, including .env reads
  // and access outside the workspace.
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],

  "providers": {
    "bobshell": {
      "name": "IBM Bob-Shell",
      "package": "aisdk:@ai-sdk/openai-compatible",
      // Raw Authorization header on purpose: the Bob gateway requires the
      // `apikey` prefix and rejects the `Bearer` token the SDK would send for
      // an apiKey setting.
      "headers": {
        "Authorization": "apikey {env:BOB_API_KEY}"
      },
      "settings": {
        "baseURL": "https://api.us-east.bob.ibm.com/inference/v1"
      },
      // Model names/limits come from GET /inference/v1/model/info on the
      // gateway (bob 2.x LiteLLM router) — the underlying Claude/GPT models
      // are not exposed by name.
      "models": {
        "premium":       { "name": "Bob: Premium (agent)", "limit": { "context": 200000,  "output": 64000 } },
        "premium-ide":   { "name": "Bob: Premium IDE",     "limit": { "context": 270000,  "output": 64000 } },
        "premium-shell": { "name": "Bob: Premium Shell",   "limit": { "context": 270000,  "output": 64000 } },
        "fast":          { "name": "Bob: Fast",            "limit": { "context": 200000,  "output": 64000 } },
        "explorer":      { "name": "Bob: Explorer",        "limit": { "context": 200000,  "output": 64000 } },
        "wxO-model":     { "name": "Bob: wxO (1M ctx)",    "limit": { "context": 1000000, "output": 64000 } }
      }
    }
  },

  "agents": {
    // ---------------------------------------------------------
    // PRIMARY AGENTS (ChatGPT Plus)
    // ---------------------------------------------------------
    "build": {
      "mode": "primary",
      "description": "Executes primary coding tasks and applies workspace edits.",
      "model": "opencode-go/glm-5.3"
    },

    "plan": {
      "mode": "primary",
      "description": "Architectural analysis, edge-case detection, and complex planning.",
      "model": "opencode-go/glm-5.3",
      "system": "You are a Staff Software Engineer. Focus on architectural analysis, identifying edge cases, and planning. Do not write the final code directly."
    },

    // ---------------------------------------------------------
    // SUBAGENTS (OpenCode Go - Tuned Tiers)
    // ---------------------------------------------------------

    // FAST READ TIER: Ultra-fast for repo scanning & symbol lookup
    "explore": {
      "mode": "subagent",
      "description": "Fast read-only exploration and codebase searching.",
      "model": "opencode-go/deepseek-v4-flash"
    },

    // GENERAL WORK TIER: Quick multi-step sub-task execution
    "general": {
      "mode": "subagent",
      "description": "General background task execution and sub-task delegation.",
      "model": "opencode-go/deepseek-v4-flash"
    },

    // HIGH INTEL TIER: GLM-5.3 for deep code inspection
    "reviewer": {
      "mode": "subagent",
      "description": "Code review, syntax checking, and diff analysis.",
      "model": "opencode-go/glm-5.3",
      "system": "Review code diffs for syntax errors, missing edge cases, security issues, and bad patterns. Keep output concise."
    },

    // Hidden maintenance agent replaces the V1 `small_model`
    // (session titles/summaries).
    "title": { "model": "opencode-go/deepseek-v4-flash" }
  },

  // Readonly kubectl against armada clusters via a Jenkins job
  // (mcp/mcp/cmd/armada, built to ~/.local/bin/armada-mcp by
  // `cd ~/mcp && go tool task build`). Credentials are hand-exported
  // from ~/keys, like BOB_API_KEY. Tools appear as armada_*; a Jenkins
  // round trip takes ~5 minutes, so batch commands into one call.
  "mcp": {
    "servers": {
      "armada": {
        "type": "local",
        "command": ["armada-mcp"],
        "environment": {
          "JENKINS_USER": "{env:JENKINS_USER}",
          "JENKINS_API_KEY": "{env:JENKINS_API_KEY}"
        }
      }
    }
  },

  "plugins": [{ "package": "./plugins/bob-user-agent.ts" }]
}
